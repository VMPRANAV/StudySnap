# FastAPI internal auth (must match Node's AI_INTERNAL_TOKEN)
AI_INTERNAL_TOKEN=change-me

# Mongo
MONGODB_URI=

# If your MONGODB_URI does not include a default DB name, set this:
MONGODB_DB=studysnap

# Providers
GROQ_API_KEY=...
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=...
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Vector search
VECTOR_INDEX_NAME=vector_index

# HTTP timeouts (seconds)
HTTP_TIMEOUT_S=60

