# Core backend
PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb+srv://...
JWT_SECRET=change-me

# FastAPI AI service (internal)
FASTAPI_AI_URL=http://localhost:8000
AI_INTERNAL_TOKEN=
FASTAPI_TIMEOUT_MS=120000

# Notes:
# - GROQ/GEMINI keys are now expected in `ai-fastapi/.env` (FastAPI service), not here.

