## StudySnap backend (Node/Express)
NODE_ENV=development
PORT=5001

# Mongo + auth
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/<db>
JWT_SECRET=change_me

# FastAPI AI service (separate service)
# IMPORTANT: In production (e.g. Render), this must be the reachable URL of your FastAPI deployment,
# not http://localhost:8000 unless both services share the same network namespace.
FASTAPI_AI_URL=http://localhost:8000
AI_INTERNAL_TOKEN=change_me
FASTAPI_TIMEOUT_MS=120000
FASTAPI_TIMEOUT_MS=120000
